---
import { withBase } from '../lib/url';

interface Crumb {
  label: string;
  href: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
const trail: Crumb[] = [{ label: 'Home', href: '/' }, ...items];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((crumb, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: crumb.label,
    item: new URL(withBase(crumb.href), Astro.site).toString(),
  })),
};
---

<nav aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-2 font-mono text-[11px] uppercase tracking-wider text-ink-500">
    {trail.map((crumb, index) => (
      <li class="flex items-center gap-2">
        {index > 0 && <span aria-hidden="true" class="text-ink-300">/</span>}
        {index === trail.length - 1 ? (
          <span class="text-ink-900" aria-current="page">{crumb.label}</span>
        ) : (
          <a href={withBase(crumb.href)} class="transition-colors hover:text-ink-900">{crumb.label}</a>
        )}
      </li>
    ))}
  </ol>
</nav>

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
