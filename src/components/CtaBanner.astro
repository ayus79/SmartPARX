---
import Button from './Button.astro';
import { SITE } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Ready to add parking capacity without adding a footprint?',
  description = 'Talk to our engineering team for a free site assessment and quotation - no obligation.',
} = Astro.props;
---

<section class="asphalt text-white">
  <div class="hazard h-2"></div>
  <div class="container-px mx-auto grid max-w-7xl items-center gap-10 py-16 sm:py-20 lg:grid-cols-[auto_1fr_auto]">
    <span class="hidden h-24 w-24 items-center justify-center rounded-lg bg-signal-500 font-display text-6xl font-extrabold text-white outline-4 outline-white -outline-offset-8 lg:flex" aria-hidden="true">P</span>
    <div>
      <h2 class="text-balance font-display text-3xl font-bold sm:text-4xl">{title}</h2>
      <p class="mt-3 max-w-xl text-base text-slate-300">{description}</p>
    </div>
    <div class="flex flex-wrap gap-4">
      <Button href="/contact" size="lg">Request a Quote</Button>
      <Button href={`tel:${SITE.phoneLinks[0]}`} variant="ghost" size="lg">Call {SITE.phone[0]}</Button>
    </div>
  </div>
  <div class="lane-line opacity-40"></div>
</section>
