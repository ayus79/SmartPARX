---
import Button from './Button.astro';
import { SITE } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Tell us about your basement. We’ll tell you how many cars fit.',
  description = 'Free site survey and quotation from our engineering team - usually within one working day.',
} = Astro.props;
---

<section class="container-px mx-auto max-w-[90rem] pb-6">
  <div class="grid-lines relative overflow-hidden rounded-[2rem] bg-ink-950 px-6 py-16 text-white sm:rounded-[2.5rem] sm:px-12 sm:py-20 lg:px-20 lg:py-28">
    <div class="pointer-events-none absolute -top-40 -right-40 h-[28rem] w-[28rem] rounded-full bg-signal-500/25 blur-[120px]" aria-hidden="true"></div>
    <div class="relative grid gap-10 lg:grid-cols-12 lg:items-end">
      <h2 class="display text-display-2 text-balance lg:col-span-8">{title}</h2>
      <div class="lg:col-span-4">
        <p class="text-ink-300">{description}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="/contact" size="lg">Request a quote</Button>
          <Button href={`tel:${SITE.phoneLinks[0]}`} variant="ghost-light" size="lg" arrow={false}>{SITE.phone[0]}</Button>
        </div>
      </div>
    </div>
  </div>
</section>
