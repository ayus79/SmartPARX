---
import { withBase } from '../lib/url';
import { getCollection } from 'astro:content';
import { NAV_LINKS, SITE } from '../lib/site';
import Logo from './Logo.astro';

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
const social = Object.entries(SITE.social).filter(([, url]) => url);
---

<footer class="relative overflow-hidden bg-ink-950 text-ink-300">
  <div class="container-px mx-auto max-w-[90rem] pt-20 pb-10">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <Logo tone="light" />
        <p class="mt-6 max-w-sm text-sm leading-relaxed text-ink-400">
          {SITE.fullName}. Designing, manufacturing and installing car parking systems in Ahmedabad since {SITE.founded}.
        </p>
        <ul class="mt-8 flex flex-wrap gap-2">
          {SITE.certifications.map((c) => (
            <li class="rounded-full border border-white/10 px-3 py-1 font-mono text-[11px] uppercase tracking-wider text-ink-300">{c}</li>
          ))}
        </ul>
      </div>

      <nav class="grid grid-cols-2 gap-10 sm:grid-cols-3 lg:col-span-8" aria-label="Footer">
        <div>
          <h2 class="font-mono text-[11px] uppercase tracking-[0.16em] text-ink-400">Products</h2>
          <ul class="mt-5 space-y-2.5 text-sm">
            {products.map((p) => (
              <li><a href={withBase(`/products/${p.id}`)} class="text-ink-300 transition-colors hover:text-white">{p.data.shortName}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="font-mono text-[11px] uppercase tracking-[0.16em] text-ink-400">Company</h2>
          <ul class="mt-5 space-y-2.5 text-sm">
            {NAV_LINKS.filter((l) => l.href !== '/products').map((link) => (
              <li><a href={withBase(link.href)} class="text-ink-300 transition-colors hover:text-white">{link.label}</a></li>
            ))}
          </ul>
          {social.length > 0 && (
            <ul class="mt-8 space-y-2.5 text-sm">
              {social.map(([name, url]) => (
                <li><a href={url} target="_blank" rel="noopener noreferrer" class="capitalize text-ink-300 hover:text-white">{name}</a></li>
              ))}
            </ul>
          )}
        </div>
        <div class="col-span-2 sm:col-span-1">
          <h2 class="font-mono text-[11px] uppercase tracking-[0.16em] text-ink-400">Contact</h2>
          <ul class="mt-5 space-y-5 text-sm">
            <li class="flex flex-col gap-1">
              {SITE.phone.map((phone, i) => (
                <a href={`tel:${SITE.phoneLinks[i]}`} class="tabular-nums text-white hover:text-signal-400">{phone}</a>
              ))}
              <a href={`mailto:${SITE.email}`} class="text-white hover:text-signal-400">{SITE.email}</a>
            </li>
            {[SITE.office, SITE.factory].map((a) => (
              <li>
                <span class="block text-ink-400">{a.label}</span>
                <span class="mt-1 block leading-relaxed">{a.line1}, {a.line2}<br />{a.city}</span>
              </li>
            ))}
          </ul>
        </div>
      </nav>
    </div>

    <!-- Solid colour, not alpha: with translucent text, overlapping glyphs stack and show seams. -->
    <p class="pointer-events-none mt-20 select-none whitespace-nowrap font-display text-[17vw] leading-[0.8] font-bold tracking-[-0.035em] text-[#18211b] lg:text-[14rem]" aria-hidden="true">
      SmartPARX
    </p>

    <div class="mt-6 flex flex-col gap-3 border-t border-white/10 pt-8 text-xs text-ink-400 sm:flex-row sm:justify-between">
      <p>&copy; {year} {SITE.fullName}. All rights reserved.</p>
      <p>{SITE.hours}</p>
    </div>
  </div>
</footer>
