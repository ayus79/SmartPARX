---
import { withBase } from '../lib/url';
import { getCollection } from 'astro:content';
import { NAV_LINKS, SITE } from '../lib/site';
import Logo from './Logo.astro';

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
const SOCIAL_META: Record<string, { label: string; path: string }> = {
  instagram: {
    label: 'Instagram',
    path: 'M12 2.2c3.2 0 3.6 0 4.8.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1.1.4 2.2.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1.1.4-2.2.4-1.3.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1.1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8c.1-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1.1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2Zm0 4.9a4.9 4.9 0 1 0 0 9.8 4.9 4.9 0 0 0 0-9.8Zm0 8.1a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4Zm5.1-9.4a1.15 1.15 0 1 0 0 2.3 1.15 1.15 0 0 0 0-2.3Z',
  },
  facebook: { label: 'Facebook', path: 'M13.5 21.9v-7.6h2.6l.4-3h-3v-1.9c0-.9.2-1.5 1.5-1.5h1.6V5.2c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H7.8v3h2.6v7.6h3.1Z' },
  linkedin: { label: 'LinkedIn', path: 'M6.9 8.9H3.6V20h3.3V8.9ZM5.2 3.6a1.9 1.9 0 1 0 0 3.8 1.9 1.9 0 0 0 0-3.8ZM20.4 13.9c0-3.3-1.8-4.9-4.2-4.9-1.9 0-2.8 1.1-3.2 1.8V8.9H9.7V20H13v-5.5c0-1.4.3-2.8 2-2.8s1.7 1.6 1.7 2.9V20h3.3l.4-6.1Z' },
  youtube: { label: 'YouTube', path: 'M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.3 5 12 5 12 5s-6.3 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2C2 8.7 2 12 2 12s0 3.3.4 4.8a2.5 2.5 0 0 0 1.8 1.8C5.7 19 12 19 12 19s6.3 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8c.4-1.5.4-4.8.4-4.8s0-3.3-.4-4.8ZM10 15V9l5.2 3L10 15Z' },
};
// Only networks with a URL in SITE.social are shown.
const social = Object.entries(SITE.social)
  .filter(([, url]) => url)
  .map(([key, url]) => ({ key, url, ...SOCIAL_META[key] }));
---

<footer class="relative overflow-hidden bg-ink-950 text-ink-300">
  <div class="container-px mx-auto max-w-[90rem] pt-20 pb-10">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <Logo tone="light" />
        <p class="mt-6 max-w-sm text-sm leading-relaxed text-ink-400">
          {SITE.fullName}. Designing, manufacturing and installing car parking systems in Ahmedabad since {SITE.founded}.
        </p>
        <ul class="mt-8 flex flex-wrap gap-2">
          {SITE.certifications.map((c) => (
            <li class="rounded-full border border-white/10 px-3 py-1 font-mono text-[11px] uppercase tracking-wider text-ink-300">{c}</li>
          ))}
        </ul>
        {social.length > 0 && (
          <div class="mt-10">
            <h2 class="font-mono text-[11px] uppercase tracking-[0.16em] text-ink-400">Follow us</h2>
            <ul class="mt-4 flex flex-wrap items-center gap-3">
              {social.map((s) => (
                <li>
                  <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={`SmartPARX on ${s.label}`} class="flex h-11 w-11 items-center justify-center rounded-full border border-white/10 text-white transition-colors hover:border-signal-500 hover:bg-signal-500 hover:text-ink-950">
                    <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>

      <nav class="grid grid-cols-2 gap-10 sm:grid-cols-3 lg:col-span-8" aria-label="Footer">
        <div>
          <h2 class="font-mono text-[11px] uppercase tracking-[0.16em] text-ink-400">Products</h2>
          <ul class="mt-5 space-y-2.5 text-sm">
            {products.map((p) => (
              <li><a href={withBase(`/products/${p.id}`)} class="text-ink-300 transition-colors hover:text-white">{p.data.shortName}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="font-mono text-[11px] uppercase tracking-[0.16em] text-ink-400">Company</h2>
          <ul class="mt-5 space-y-2.5 text-sm">
            {NAV_LINKS.filter((l) => l.href !== '/products').map((link) => (
              <li><a href={withBase(link.href)} class="text-ink-300 transition-colors hover:text-white">{link.label}</a></li>
            ))}
          </ul>
        </div>
        <div class="col-span-2 sm:col-span-1">
          <h2 class="font-mono text-[11px] uppercase tracking-[0.16em] text-ink-400">Contact</h2>
          <ul class="mt-5 space-y-5 text-sm">
            <li class="flex flex-col gap-1">
              {SITE.phone.map((phone, i) => (
                <a href={`tel:${SITE.phoneLinks[i]}`} class="tabular-nums text-white hover:text-signal-400">{phone}</a>
              ))}
              <a href={`mailto:${SITE.email}`} class="text-white hover:text-signal-400">{SITE.email}</a>
            </li>
            {[SITE.office, SITE.factory].map((a) => (
              <li>
                <span class="block text-ink-400">{a.label}</span>
                <span class="mt-1 block leading-relaxed">{a.line1}, {a.line2}<br />{a.city}</span>
              </li>
            ))}
          </ul>
        </div>
      </nav>
    </div>

    <!-- Solid colour, not alpha: with translucent text, overlapping glyphs stack and show seams. -->
    <p class="pointer-events-none mt-20 select-none whitespace-nowrap font-display text-[17vw] leading-[0.8] font-bold tracking-[-0.035em] text-[#18211b] lg:text-[14rem]" aria-hidden="true">
      SmartPARX
    </p>

    <div class="mt-6 flex flex-col gap-3 border-t border-white/10 pt-8 text-xs text-ink-400 sm:flex-row sm:justify-between">
      <p>&copy; {year} {SITE.fullName}. All rights reserved.</p>
      <p>{SITE.hours}</p>
    </div>
  </div>
</footer>
