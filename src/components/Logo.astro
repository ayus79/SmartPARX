---
// Typographic version of the SmartPARX wordmark ("Smart" + green "PARX", tagline below).
// Replace with the client's vector logo when supplied.
interface Props {
  tone?: 'dark' | 'light';
  tagline?: boolean;
}

const { tone = 'dark', tagline = true } = Astro.props;
---

<a href="/" class="inline-flex flex-col leading-none" aria-label="SmartPARX - home">
  <span class:list={['font-display text-[1.45rem] font-bold tracking-[-0.04em]', tone === 'dark' ? 'text-ink-900' : 'text-white']}>
    Smart<span class="text-signal-500">PARX</span>
  </span>
  {tagline && (
    <span class:list={['mt-1 text-[0.62rem] font-medium italic tracking-wide', tone === 'dark' ? 'text-ink-500' : 'text-ink-300']}>
      Do it the smart way
    </span>
  )}
</a>
