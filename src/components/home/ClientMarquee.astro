---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const logos = import.meta.glob<{ default: ImageMetadata }>('../../assets/images/clients/*.png', { eager: true });
const names: Record<string, string> = {
  avirat: 'Avirat Infrastructure',
  corus: 'Corus Infrastructure',
  moksha: 'Moksha Buildcon',
  nakshatra: 'Nakshatra',
  sahajanand: 'Sahajanand Group',
  samruddhi: 'Samruddhi, AmthiNath & Siddhant Group',
  sanelite: 'Sanelite Group',
  setu: 'Setu',
  shayona: 'Shayona Group',
  triveni: 'Triveni Infra Build',
  utpal: 'Utpal Spaces LLP',
};
const items = Object.entries(logos).map(([path, mod]) => {
  const key = path.split('/').pop()!.replace('.png', '');
  return { key, src: mod.default, alt: names[key] ?? key, dark: key === 'avirat' };
});
---

<section class="py-16 sm:py-20" aria-labelledby="clients-title">
  <div class="container-px mx-auto flex max-w-[90rem] flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <h2 id="clients-title" class="max-w-md font-display text-xl font-medium tracking-tight text-ink-900 sm:text-2xl">
      Trusted by <span class="text-signal-600">70+ developers</span> and enterprises across Gujarat.
    </h2>
    <a href="#testimonials" class="link-arrow text-ink-700 hover:text-ink-900">
      What they say
      <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </a>
  </div>

  <div class="group relative mt-10 overflow-hidden [mask-image:linear-gradient(90deg,transparent,#000_8%,#000_92%,transparent)]">
    <ul class="flex w-max animate-marquee gap-4 group-hover:[animation-play-state:paused]">
      {[...items, ...items].map((logo, i) => (
        <li
          class:list={['flex h-24 w-52 shrink-0 items-center justify-center rounded-2xl px-6', logo.dark ? 'bg-ink-900' : 'bg-white']}
          aria-hidden={i >= items.length ? 'true' : undefined}
        >
          <Image src={logo.src} alt={i >= items.length ? '' : logo.alt} class="max-h-14 w-auto object-contain" loading="lazy" />
        </li>
      ))}
    </ul>
  </div>
</section>
