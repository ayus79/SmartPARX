---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Button from '../Button.astro';

const models = (await getCollection('products', (p) => p.data.family === 'two-post')).sort(
  (a, b) => a.data.order - b.data.order,
);
const maxKg = Math.max(...models.map((m) => m.data.capacityKg ?? 0));
const pct = (kg?: number) => (kg ? Math.round((kg / maxKg) * 100) : 0);
---

<section id="range" class="grid-lines relative bg-ink-950 text-white section-py" aria-labelledby="range-title">
  <div class="container-px mx-auto max-w-[90rem]">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="kicker kicker-light">01 - Two-post stackers</p>
        <h2 id="range-title" class="display mt-6 text-display-2">
          Four models.<br /><span class="text-ink-400">One for every car and budget.</span>
        </h2>
      </div>
      <p class="max-w-md text-ink-300 lg:col-span-5 lg:justify-self-end">
        Every SmartPARX stacker doubles a bay without excavation. Choose by the heaviest car you'll park on top - and whether it goes in nose-first or in reverse.
      </p>
    </div>

    <div class="mt-14 lg:mt-20" data-tabs>
      <div role="tablist" aria-label="Stacker models" class="grid grid-cols-2 gap-2 sm:grid-cols-4">
        {models.map((m, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${m.id}`}
            aria-controls={`panel-${m.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="group rounded-2xl border border-white/10 p-4 text-left transition-colors hover:border-white/30 aria-selected:border-signal-500 aria-selected:bg-signal-500 aria-selected:text-ink-950 sm:p-5"
          >
            <span class="flex items-center justify-between font-mono text-[11px] uppercase tracking-wider text-ink-400 group-aria-selected:text-ink-950/70">
              {m.data.model}
              <span>0{i + 1}</span>
            </span>
            <span class="mt-3 block font-display text-xl font-semibold tracking-tight sm:text-2xl">{m.data.shortName}</span>
            <span class="mt-1 block text-sm tabular-nums text-ink-300 group-aria-selected:text-ink-950/80">{m.data.capacity}</span>
          </button>
        ))}
      </div>

      {models.map((m, i) => (
        <div
          role="tabpanel"
          id={`panel-${m.id}`}
          aria-labelledby={`tab-${m.id}`}
          hidden={i !== 0}
          class="mt-6 grid gap-6 lg:grid-cols-12"
        >
          <div class="relative overflow-hidden rounded-[1.75rem] bg-[#e9e9e7] lg:col-span-7">
            {m.data.image && (
              <Image
                src={m.data.image}
                alt={`SmartPARX ${m.data.title} render`}
                widths={[640, 960, 1280]}
                sizes="(min-width: 1024px) 760px, 100vw"
                class="aspect-[16/10] h-full w-full object-cover"
                loading="lazy"
              />
            )}
            <div class="absolute top-5 left-5 flex flex-wrap gap-1.5">
              {m.data.variants.map((v) => (
                <span class="rounded-full bg-ink-950/85 px-2.5 py-1 font-mono text-[10px] tracking-wider text-white">{v}</span>
              ))}
            </div>
          </div>

          <div class="flex flex-col rounded-[1.75rem] border border-white/10 bg-ink-900/60 p-6 sm:p-8 lg:col-span-5">
            <p class="text-pretty text-ink-300">{m.data.summary}</p>

            <div class="mt-8 space-y-5">
              {[
                { label: 'Lifting capacity', value: m.data.capacity, w: pct(m.data.capacityKg), tone: 'text-signal-500' },
                { label: 'Reverse parking', value: m.data.reverseParking?.replace(' advisable', ''), w: pct(m.data.reverseKg), tone: 'text-amber-400' },
              ].map((bar) => (
                <div>
                  <div class="flex justify-between text-sm">
                    <span class="text-ink-400">{bar.label}</span>
                    <span class="font-semibold tabular-nums">{bar.value}</span>
                  </div>
                  <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-white/10">
                    <!-- SVG width attribute instead of an inline style, which the CSP blocks. -->
                    <svg class:list={['block h-full w-full', bar.tone]} aria-hidden="true"><rect width={`${bar.w}%`} height="100%" rx="3" fill="currentColor" /></svg>
                  </div>
                </div>
              ))}
            </div>

            <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-5 border-t border-white/10 pt-6 text-sm">
              <div><dt class="text-ink-400">Base length</dt><dd class="mt-1 font-medium">{m.data.baseLength}</dd></div>
              <div><dt class="text-ink-400">System weight</dt><dd class="mt-1 font-medium">{m.data.weight}</dd></div>
              <div class="col-span-2"><dt class="text-ink-400">Lift mechanism</dt><dd class="mt-1 font-medium">{m.data.mechanism}</dd></div>
            </dl>

            <div class="mt-auto flex flex-wrap items-center justify-between gap-4 pt-8">
              <span class="font-mono text-[11px] uppercase tracking-wider text-ink-400">{m.data.addons.length} add-ons available</span>
              <Button href={`/products/${m.id}`} size="md">Full specs</Button>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls')!);
        if (panel) panel.hidden = !on;
      });
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const dir = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!dir) return;
        e.preventDefault();
        const next = tabs[(i + dir + tabs.length) % tabs.length];
        next.focus();
        select(next);
      });
    });
  });
</script>
