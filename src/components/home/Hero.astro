---
import Button from '../Button.astro';
import { STATS } from '../../lib/site';
---

<section class="relative overflow-hidden bg-navy-950 text-white">
  <div class="pointer-events-none absolute inset-0 opacity-40" aria-hidden="true">
    <div class="absolute -top-24 -right-24 h-96 w-96 rounded-full bg-signal-500/20 blur-3xl"></div>
    <div class="absolute bottom-0 left-1/4 h-72 w-72 rounded-full bg-navy-700/40 blur-3xl"></div>
  </div>

  <div class="relative container-px mx-auto max-w-7xl pt-20 pb-16 sm:pt-28 sm:pb-24 lg:pt-36 lg:pb-32">
    <div class="max-w-3xl">
      <h1 class="text-balance font-display text-4xl font-bold leading-tight sm:text-5xl lg:text-6xl">
        Engineering Next-Gen <span class="text-signal-500">Automated Parking</span> Solutions
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-300">
        SmartPARX researches, designs, manufactures, and installs automated parking equipment for hotels, malls, apartments, and commercial towers - across India and beyond.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <Button href="/products" size="lg">Explore Products</Button>
        <Button href="/contact" variant="ghost" size="lg">Get Free Consultation</Button>
      </div>
    </div>

    <dl class="mt-20 grid grid-cols-2 gap-6 border-t border-white/10 pt-10 sm:grid-cols-4">
      {STATS.map((stat) => (
        <div>
          <dt class="sr-only">{stat.label}</dt>
          <dd class="font-display text-3xl font-bold text-signal-500 sm:text-4xl">{stat.value}</dd>
          <p class="mt-1 text-sm text-slate-400">{stat.label}</p>
        </div>
      ))}
    </dl>
  </div>
</section>
