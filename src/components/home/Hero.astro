---
import { Picture } from 'astro:assets';
import Button from '../Button.astro';
import { SITE, STATS } from '../../lib/site';
import heroImage from '../../assets/images/projects/two-level-1.jpg';
---

<section class="relative">
  <div class="container-px mx-auto max-w-[90rem] pt-10 sm:pt-16 lg:pt-20">
    <div class="grid items-end gap-10 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <p class="kicker">Car parking systems</p>
        <h1 class="display mt-7 text-[clamp(3rem,8.4vw,7.5rem)] text-ink-900">
          Twice the cars.<br />
          <span class="text-signal-600">Same floor.</span>
        </h1>
      </div>
      <div class="lg:col-span-4 lg:pb-3">
        <p class="max-w-md text-lg leading-relaxed text-pretty text-ink-600">
          Two-post stackers, puzzle, pit and heavy-duty parking systems - designed, manufactured and installed by SmartPARX, with hydraulics made in-house.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="/contact" size="lg">Free site survey</Button>
          <Button href="#planner" variant="outline" size="lg" arrow={false}>Will it fit?</Button>
        </div>
      </div>
    </div>
  </div>

  <div class="container-px mx-auto mt-12 max-w-[90rem] sm:mt-16">
    <div class="relative overflow-hidden rounded-[1.75rem] bg-ink-900 sm:rounded-[2.5rem]">
      <Picture
        src={heroImage}
        formats={['avif', 'webp']}
        widths={[640, 960, 1440, 1920, 2400]}
        sizes="(min-width: 1440px) 1440px, 100vw"
        alt="A row of SmartPARX two-post parking stackers installed in a basement car park"
        loading="eager"
        fetchpriority="high"
        class="aspect-[4/5] w-full object-cover sm:aspect-[16/10] lg:aspect-[21/9]"
      />
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink-950/90 via-ink-950/20 to-transparent"></div>

      <div class="absolute top-5 left-5 flex items-center gap-2 rounded-full bg-white/90 py-1.5 pr-4 pl-1.5 text-xs font-medium text-ink-900 backdrop-blur sm:top-7 sm:left-7">
        <span class="rounded-full bg-signal-500 px-2.5 py-1 font-mono text-[10px] font-semibold uppercase tracking-wider text-ink-950">Installed</span>
        Two-post stacker row
      </div>

      <dl class="absolute inset-x-0 bottom-0 grid grid-cols-2 text-white sm:grid-cols-4">
        {STATS.map((stat, i) => (
          <div class:list={['flex flex-col-reverse p-5 sm:p-7 lg:p-9', i > 0 && 'sm:border-l sm:border-white/15']}>
            <dt class="mt-1.5 text-xs leading-snug text-white/75 sm:text-sm">{stat.label}</dt>
            <dd class="display text-4xl tabular-nums sm:text-5xl lg:text-6xl">{stat.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
