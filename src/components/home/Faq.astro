---
const faqs = [
  {
    question: 'What is an automated car parking system?',
    answer:
      'An automated car parking system uses mechanical lifts, pallets, or rotary structures to stack or move vehicles into storage positions, letting a site fit significantly more cars into the same footprint than conventional flat parking.',
  },
  {
    question: 'How much extra parking capacity can a stacker system add?',
    answer:
      'A two-level stacker roughly doubles capacity in the same footprint, while a three-level stacker or puzzle system can triple it or more, depending on ceiling height, pit availability, and site layout.',
  },
  {
    question: 'How long does installation take?',
    answer:
      'Most single or two-level stacker installations are completed within 2-4 weeks of manufacturing being finished. Larger puzzle or vertical circulation systems take longer depending on structural and PLC integration work.',
  },
  {
    question: 'Do SmartPARX systems require a pit or can they be surface-mounted?',
    answer:
      'Both. We offer surface-mounted stackers for sites with adequate height clearance, and pit-based systems for height-restricted locations. Our team recommends the right configuration after a site assessment.',
  },
  {
    question: 'Does SmartPARX provide maintenance after installation?',
    answer:
      'Yes. We offer Annual Maintenance Contracts (AMC) covering hydraulic, electrical, and structural components to keep systems running safely and reliably after commissioning.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<section class="section-py bg-white">
  <div class="container-px mx-auto max-w-4xl">
    <h2 class="text-balance text-center font-display text-3xl font-bold text-navy-900 sm:text-4xl">
      Frequently Asked Questions
    </h2>

    <div class="mt-10 divide-y divide-slate-200 border-y border-slate-200">
      {faqs.map((faq) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-base font-semibold text-navy-900">
            {faq.question}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="h-5 w-5 shrink-0 text-navy-500 transition-transform group-open:rotate-45">
              <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-navy-600">{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
