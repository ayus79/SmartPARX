---
import { withBase } from '../../lib/url';
interface Props {
  title?: string;
}

const { title = 'Questions developers ask us' } = Astro.props;

const faqs = [
  {
    question: 'How much clear height does a two-level car parking stacker need?',
    answer:
      'For two sedans you need about 3400 mm of clear height; for an SUV above a sedan, 3800 mm; and for two SUVs, 4300 mm. These figures exclude fire-suppression pipes, plumbing and other services below the slab.',
  },
  {
    question: 'How wide should the bay and driveway be?',
    answer:
      'With a 2200 mm platform (our recommended minimum for Indian cars) you need 2580 mm between columns for one bay, 5160 mm for two and 7740 mm for three. Plan a driveway of at least 5500 mm, or 6000 mm if cars are longer than 4.7 m.',
  },
  {
    question: 'Which stacker model should I choose?',
    answer:
      'Choose by the heaviest car on the upper platform and whether it parks in reverse. Economy lifts 2000 kg, Premium 2300 kg, Premium+ 2500 kg and Luxury+ 2700 kg, with reverse-parking limits of 1450, 1800, 2000 and 2350 kg respectively.',
  },
  {
    question: 'Can parking systems be installed after the building is complete?',
    answer:
      'Yes. Our systems can be planned before or after BU/OC permission and are customised around walls, D-walls and boundary or retaining walls. Premium+ and Luxury+ have extra-long bases that need no ceiling supports or slab punctures.',
  },
  {
    question: 'What warranty do SmartPARX systems carry?',
    answer:
      'Every system comes with a 2-year zero-pay warranty, and an additional 5 years of warranty with an Annual Maintenance Contract. The zero-pay warranty excludes damage from water logging, debris, theft, fire and natural events.',
  },
  {
    question: 'Are the systems compatible with EV charging?',
    answer:
      'Yes - all SmartPARX parking systems are EV-charging compatible, and an EV charging provision is available as an add-on on Premium+, Luxury+ and heavy-duty models.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

<section class="section-py" aria-labelledby="faq-title">
  <div class="container-px mx-auto grid max-w-[90rem] gap-12 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <p class="kicker">FAQ</p>
      <h2 id="faq-title" class="display mt-6 text-display-2 text-ink-900">{title}</h2>
      <p class="mt-5 text-ink-600">
        Still unsure? <a href={withBase('/planning-guide')} class="font-semibold text-ink-900 underline decoration-signal-500 decoration-2 underline-offset-4">Read the planning guide</a>.
      </p>
    </div>
    <div class="divide-y divide-paper-300 border-y border-paper-300 lg:col-span-8">
      {faqs.map((faq) => (
        <details class="group py-6 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 font-display text-lg font-medium tracking-tight text-ink-900 sm:text-xl">
            {faq.question}
            <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-paper-300 transition-transform duration-300 group-open:rotate-45 group-open:border-ink-900 group-open:bg-ink-900 group-open:text-white" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
            </span>
          </summary>
          <p class="mt-4 max-w-2xl leading-relaxed text-ink-600">{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
