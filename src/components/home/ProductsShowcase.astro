---
import { getCollection } from 'astro:content';
import ProductCard from '../ProductCard.astro';
import Button from '../Button.astro';

const products = (await getCollection('products'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);
---

<section class="section-py bg-slate-50">
  <div class="container-px mx-auto max-w-7xl">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <span class="text-sm font-semibold uppercase tracking-wide text-signal-600">Our Systems</span>
        <h2 class="mt-3 text-balance font-display text-3xl font-bold text-navy-900 sm:text-4xl">
          A parking system for every site
        </h2>
      </div>
      <Button href="/products" variant="secondary" class="self-start sm:self-auto">View All Products</Button>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {products.map((product) => <ProductCard product={product} />)}
    </div>
  </div>
</section>
