---
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import { Eye, Target, Factory, MapPin } from 'lucide-static';

const values = [
  {
    title: 'Vision',
    icon: Eye,
    description: 'Building strong, lasting customer relationships through engineering trust.',
  },
  {
    title: 'Mission',
    icon: Target,
    description: 'Meeting India’s growing parking demand with innovative, space-efficient solutions.',
  },
  {
    title: 'Facility',
    icon: Factory,
    description: '10,000+ sq. ft. state-of-the-art manufacturing facility in Ahmedabad.',
  },
  {
    title: 'Sectors Served',
    icon: MapPin,
    description: 'Hotels, malls, apartments, commercial and smart buildings nationwide.',
  },
];
---

<section class="section-py blueprint">
  <div class="container-px mx-auto max-w-7xl">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
      <div>
        <span class="eyebrow">About SmartPARX</span>
        <h2 class="mt-4 text-balance font-display text-3xl font-bold text-navy-900 sm:text-4xl">
          35+ years of engineering experience behind every installation
        </h2>
        <p class="mt-5 text-base leading-relaxed text-navy-600">
          SmartPARX specializes in the research, development, design, manufacturing, marketing, installation, and commissioning of automated parking equipment. From single-bay stackers to multi-tier puzzle systems, every project is engineered in-house at our own facility.
        </p>
        <div class="mt-8">
          <Button href="/about" variant="secondary">Learn More About Us</Button>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        {values.map((value) => (
          <div class="group rounded-lg border border-slate-200 border-t-4 border-t-navy-900 bg-white p-6 transition-colors hover:border-t-signal-500">
            <span class="flex h-11 w-11 items-center justify-center rounded-md bg-slate-100 text-signal-600 transition-colors group-hover:bg-signal-500 group-hover:text-navy-950">
              <Icon svg={value.icon} class="h-5 w-5" />
            </span>
            <h3 class="mt-4 font-display text-lg font-semibold text-navy-900">{value.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-navy-600">{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
