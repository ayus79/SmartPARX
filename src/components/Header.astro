---
import { NAV_LINKS, SITE } from '../lib/site';
import Button from './Button.astro';
import Logo from './Logo.astro';

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);
---

<header id="site-header" class="sticky top-0 z-50 border-b border-transparent bg-paper/80 backdrop-blur-xl transition-[border-color,background-color] duration-300 data-[scrolled]:border-paper-300 data-[scrolled]:bg-paper/95 data-[menu-open]:border-paper-300 data-[menu-open]:bg-paper">
  <div class="container-px mx-auto flex h-[4.5rem] max-w-[90rem] items-center justify-between gap-6">
    <Logo />

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      {NAV_LINKS.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
          class:list={[
            'rounded-full px-4 py-2 text-sm font-medium transition-colors',
            isActive(link.href) ? 'bg-ink-900 text-white' : 'text-ink-700 hover:bg-paper-200 hover:text-ink-900',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-5 lg:flex">
      <a href={`tel:${SITE.phoneLinks[0]}`} class="text-sm font-semibold tabular-nums text-ink-900 hover:text-signal-600">
        {SITE.phone[0]}
      </a>
      <Button href="/contact" variant="dark">Get a quote</Button>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="relative flex h-11 w-11 items-center justify-center rounded-full bg-ink-900 text-white lg:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="menu-bar absolute h-[1.5px] w-4 -translate-y-[3px] bg-current transition-transform duration-300"></span>
      <span class="menu-bar absolute h-[1.5px] w-4 translate-y-[3px] bg-current transition-transform duration-300"></span>
    </button>
  </div>

</header>

<!-- Kept outside <header>: its backdrop-filter would otherwise trap this fixed overlay inside the header box. -->
<div id="mobile-menu" class="fixed inset-x-0 top-[4.5rem] bottom-0 z-[45] hidden flex-col overflow-y-auto bg-paper lg:hidden">
    <nav class="container-px flex flex-1 flex-col justify-center gap-1" aria-label="Mobile">
      {[...NAV_LINKS, { label: 'Contact', href: '/contact' }].map((link, i) => (
        <a href={link.href} class="flex items-baseline gap-4 border-b border-paper-300 py-4 font-display text-3xl font-semibold tracking-tight text-ink-900">
          <span class="font-mono text-xs text-ink-500">0{i + 1}</span>
          {link.label}
        </a>
      ))}
    </nav>
    <div class="container-px flex flex-col gap-3 pb-8">
      <a href={`tel:${SITE.phoneLinks[0]}`} class="text-lg font-semibold text-ink-900">{SITE.phone[0]}</a>
      <a href={`mailto:${SITE.email}`} class="text-ink-600">{SITE.email}</a>
    </div>
  </div>


<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const bars = toggle?.querySelectorAll<HTMLElement>('.menu-bar');

  const onScroll = () => header?.toggleAttribute('data-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    if (!toggle) return;
    toggle.setAttribute('aria-expanded', String(open));
    header?.toggleAttribute('data-menu-open', open);
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    menu?.classList.toggle('hidden', !open);
    menu?.classList.toggle('flex', open);
    document.body.style.overflow = open ? 'hidden' : '';
    if (bars) {
      bars[0].style.transform = open ? 'rotate(45deg)' : '';
      bars[1].style.transform = open ? 'rotate(-45deg)' : '';
    }
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && setOpen(false));
</script>
