---
import { NAV_LINKS, SITE } from '../lib/site';
import Button from './Button.astro';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { Phone, Mail, Clock } from 'lucide-static';

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<div class="hidden bg-navy-950 text-slate-400 md:block">
  <div class="container-px mx-auto flex max-w-7xl items-center justify-between py-2 font-mono text-xs">
    <span class="inline-flex items-center gap-2">
      <Icon svg={Clock} class="h-3.5 w-3.5 text-signal-400" />
      {SITE.hours}
    </span>
    <div class="flex items-center gap-6">
      <a href={`mailto:${SITE.email}`} class="inline-flex items-center gap-2 hover:text-white">
        <Icon svg={Mail} class="h-3.5 w-3.5 text-signal-400" />
        {SITE.email}
      </a>
      <a href={`tel:${SITE.phoneLinks[1]}`} class="inline-flex items-center gap-2 hover:text-white">
        <Icon svg={Phone} class="h-3.5 w-3.5 text-signal-400" />
        {SITE.phone[1]}
      </a>
    </div>
  </div>
</div>

<header class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur">
  <div class="container-px mx-auto flex h-18 max-w-7xl items-center justify-between py-3">
    <Logo />

    <nav class="hidden lg:flex items-center gap-8">
      {NAV_LINKS.map((link) => (
        <a
          href={link.href}
          class={`relative py-2 text-sm font-medium transition-colors hover:text-signal-600 ${
            isActive(link.href)
              ? 'font-semibold text-navy-900 after:absolute after:inset-x-0 after:-bottom-[15px] after:h-[3px] after:bg-signal-500'
              : 'text-navy-600'
          }`}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="hidden lg:flex items-center gap-3">
      <a href={`tel:${SITE.phoneLinks[0]}`} class="flex items-center gap-2.5 text-navy-900 hover:text-signal-600">
        <span class="flex h-9 w-9 items-center justify-center rounded-md bg-slate-100 text-signal-600">
          <Icon svg={Phone} class="h-4 w-4" />
        </span>
        <span class="leading-tight">
          <span class="block font-mono text-[10px] uppercase tracking-widest text-navy-600">Call Sales</span>
          <span class="text-sm font-semibold">{SITE.phone[0]}</span>
        </span>
      </a>
      <Button href="/contact" size="md">Get a Quote</Button>
    </div>

    <button
      id="mobile-menu-toggle"
      type="button"
      class="lg:hidden flex h-10 w-10 items-center justify-center rounded-md border border-slate-200 text-navy-900"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-5 w-5" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
      <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="hidden h-5 w-5" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-100 bg-white">
    <nav class="container-px mx-auto flex max-w-7xl flex-col gap-1 py-4">
      {NAV_LINKS.map((link) => (
        <a
          href={link.href}
          class={`rounded-lg px-3 py-2.5 text-base font-medium ${
            isActive(link.href) ? 'bg-slate-50 text-navy-900 font-semibold border-l-4 border-signal-500' : 'text-navy-700'
          }`}
        >
          {link.label}
        </a>
      ))}
      <div class="mt-2 flex flex-col gap-3 px-3">
        <a href={`tel:${SITE.phoneLinks[0]}`} class="text-sm font-semibold text-navy-700">
          Call {SITE.phone[0]}
        </a>
        <Button href="/contact" size="md" class="w-full">Get a Quote</Button>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isHidden = menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(Boolean(isHidden)));
  });
</script>
