---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg';
  class?: string;
}

const { href, variant = 'primary', size = 'md', class: className = '' } = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-full font-semibold transition-colors duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2';

const variants = {
  primary: 'bg-signal-500 text-navy-950 hover:bg-signal-400 focus-visible:outline-signal-500',
  secondary:
    'bg-navy-900 text-white hover:bg-navy-800 focus-visible:outline-navy-900',
  ghost:
    'bg-white/10 text-white border border-white/30 hover:bg-white/20 focus-visible:outline-white',
};

const sizes = {
  md: 'px-5 py-2.5 text-sm',
  lg: 'px-7 py-3.5 text-base',
};
---

<a href={href} class={`${base} ${variants[variant]} ${sizes[size]} ${className}`}>
  <slot />
</a>
