---
/**
 * Technical side-elevation drawings of each SmartPARX system family.
 * Drawn for dark (asphalt) backgrounds; used until real project photography is available.
 */
import type { Visual } from '../lib/visuals';

interface Props {
  variant: Visual;
  animate?: boolean;
  class?: string;
}

const { variant, animate = false, class: className = '' } = Astro.props; // animate: puzzle pallet shuffle

const C = {
  ground: '#1d2721',
  groundLine: '#5d6a62',
  steel: '#2e3a33',
  steelEdge: '#45524a',
  pallet: '#00a456',
  car: '#b7bfba',
  carAccent: '#1fc06f',
  glass: '#0b110d',
  tyre: '#0b110d',
  hub: '#8a958e',
  label: '#5d6a62',
};

// Car side profile in a 100 x 32 local box; (x, y) is where the tyres touch the deck.
const CAR_BODY =
  'M4 25V18q0-4.5 5-5.5l16-2L35 3q2-1.5 5-1.5h25q3 0 5 2l8 7.5 13 2q5 1 5 6v6Z';
const CAR_GLASS = 'M37 5h26q2 0 3.5 1.5l5.5 5H31Z';

interface Placed {
  x: number;
  y: number;
  s: number;
  accent?: boolean;
}

const car = ({ x, y, s, accent }: Placed) => ({
  transform: `translate(${x} ${y - 32 * s}) scale(${s})`,
  fill: accent ? C.carAccent : C.car,
});

// Static layouts per variant.
const stacker2 = { posts: [34, 274], top: 40, ground: 176, decks: [96], cars: [
  { x: 60, y: 96, s: 2, accent: true },
  { x: 60, y: 176, s: 2 },
] };
const stacker3 = { posts: [46, 262], top: 14, ground: 180, decks: [72, 126], cars: [
  { x: 82, y: 72, s: 1.55 },
  { x: 82, y: 126, s: 1.55, accent: true },
  { x: 82, y: 180, s: 1.55 },
] };

// Puzzle matrix: 3 x 3, bottom-middle cell is the empty shuffle slot.
const puzzleCols = [16, 112, 208];
const puzzleRows = [72, 124, 176];
const puzzleCells = puzzleRows.flatMap((y, r) =>
  puzzleCols.map((x, c) => ({ x, y, r, c, empty: r === 2 && c === 1, moving: r === 1 && c === 1 })),
);

const rotarySlots = [52, 92, 132, 172].flatMap((y) => [
  { x: 116, y, s: 0.42 },
  { x: 162, y, s: 0.42 },
]);
---

<svg
  viewBox="0 0 320 200"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  role="img"
  aria-label={`Diagram of a ${variant.replace(/\d/, '-level ')} parking system`}
>
  {(variant === 'stacker2' || variant === 'stacker3') && (() => {
    const v = variant === 'stacker2' ? stacker2 : stacker3;
    const deckLeft = v.posts[0] + 6;
    const deckWidth = v.posts[1] - deckLeft + 6;
    return (
      <g>
        <rect x="0" y={v.ground} width="320" height={200 - v.ground} fill={C.ground} />
        <line x1="0" x2="320" y1={v.ground} y2={v.ground} stroke={C.groundLine} stroke-width="1.5" />
        {v.posts.map((px) => (
          <g>
            <rect x={px} y={v.top} width="12" height={v.ground - v.top} fill={C.steel} stroke={C.steelEdge} />
            <rect x={px - 3} y={v.ground - 4} width="18" height="4" fill={C.steelEdge} />
            <line x1={px + 6} x2={px + 6} y1={v.top + 6} y2={v.ground - 10} stroke={C.steelEdge} stroke-dasharray="2 4" />
          </g>
        ))}
        {v.decks.map((dy) => (
          <g>
            <rect x={deckLeft} y={dy} width={deckWidth} height="7" fill={C.pallet} />
            <path d={`M${deckLeft + 10} ${dy + 7}l8 6h${deckWidth - 36}l8-6`} fill="none" stroke={C.pallet} stroke-opacity="0.5" />
          </g>
        ))}
        {v.cars.map((p) => {
          const c = car(p);
          return (
            <g transform={c.transform}>
              <path d={CAR_BODY} fill={c.fill} />
              <path d={CAR_GLASS} fill={C.glass} fill-opacity="0.75" />
              <circle cx="24" cy="26" r="6" fill={C.tyre} /><circle cx="24" cy="26" r="2.4" fill={C.hub} />
              <circle cx="76" cy="26" r="6" fill={C.tyre} /><circle cx="76" cy="26" r="2.4" fill={C.hub} />
            </g>
          );
        })}
        <g stroke={C.label} stroke-width="1">
          <line x1="306" x2="306" y1={v.top} y2={v.ground} />
          <line x1="302" x2="310" y1={v.top} y2={v.top} />
          <line x1="302" x2="310" y1={v.ground} y2={v.ground} />
        </g>
        <text x="300" y={v.top - 4} fill={C.label} font-family="ui-monospace, monospace" font-size="9" text-anchor="end">
          {variant === 'stacker2' ? 'L1 / L2' : 'L1 / L2 / L3'}
        </text>
      </g>
    );
  })()}

  {variant === 'pit' && (
    <g>
      <rect x="0" y="96" width="320" height="104" fill={C.ground} />
      <rect x="30" y="96" width="260" height="96" fill="#121a15" stroke={C.groundLine} stroke-dasharray="4 3" />
      {Array.from({ length: 9 }, (_, i) => (
        <g stroke={C.steelEdge} stroke-width="1">
          <line x1="4" x2="26" y1={104 + i * 10} y2={96 + i * 10} />
          <line x1="294" x2="316" y1={104 + i * 10} y2={96 + i * 10} />
        </g>
      ))}
      <line x1="0" x2="30" y1="96" y2="96" stroke={C.groundLine} stroke-width="1.5" />
      <line x1="290" x2="320" y1="96" y2="96" stroke={C.groundLine} stroke-width="1.5" />
      <text x="2" y="90" fill={C.label} font-family="ui-monospace, monospace" font-size="8">±0.00</text>
      {[38, 270].map((px) => (
        <rect x={px} y="28" width="12" height="164" fill={C.steel} stroke={C.steelEdge} />
      ))}
      <rect x="44" y="96" width="232" height="7" fill={C.pallet} />
      <rect x="44" y="184" width="232" height="7" fill={C.pallet} />
      {[{ x: 70, y: 96, s: 1.8, accent: true }, { x: 70, y: 184, s: 1.8 }].map((p) => {
        const c = car(p);
        return (
          <g transform={c.transform}>
            <path d={CAR_BODY} fill={c.fill} />
            <path d={CAR_GLASS} fill={C.glass} fill-opacity="0.75" />
            <circle cx="24" cy="26" r="6" fill={C.tyre} /><circle cx="24" cy="26" r="2.4" fill={C.hub} />
            <circle cx="76" cy="26" r="6" fill={C.tyre} /><circle cx="76" cy="26" r="2.4" fill={C.hub} />
          </g>
        );
      })}
      <text x="264" y="140" fill={C.label} font-family="ui-monospace, monospace" font-size="9" text-anchor="end">PIT</text>
    </g>
  )}

  {variant === 'puzzle' && (
    <g>
      <rect x="0" y="176" width="320" height="24" fill={C.ground} />
      <line x1="0" x2="320" y1="176" y2="176" stroke={C.groundLine} stroke-width="1.5" />
      {[16, 112, 208, 304].map((x) => (
        <rect x={x - 3} y="18" width="6" height="158" fill={C.steel} stroke={C.steelEdge} />
      ))}
      <rect x="13" y="16" width="294" height="5" fill={C.steelEdge} />
      {puzzleCells.map((cell) =>
        cell.empty ? (
          <g>
            <rect x={cell.x + 8} y={cell.y - 46} width="80" height="42" fill="none" stroke={C.pallet} stroke-dasharray="4 4" stroke-opacity="0.7" />
            <path d={`M${cell.x + 48} ${cell.y - 36}v18m-6-6 6 6 6-6`} fill="none" stroke={C.pallet} stroke-width="1.5" />
          </g>
        ) : (
          <g class={animate && cell.moving ? 'animate-pallet' : undefined} style={animate && cell.moving ? '--pallet-travel: 52px' : undefined}>
            <rect x={cell.x + 6} y={cell.y - 4} width="84" height="4" fill={C.pallet} />
            <g transform={car({ x: cell.x + 9, y: cell.y - 4, s: 0.78 }).transform}>
              <path d={CAR_BODY} fill={cell.moving ? C.carAccent : C.car} />
              <path d={CAR_GLASS} fill={C.glass} fill-opacity="0.75" />
              <circle cx="24" cy="26" r="6" fill={C.tyre} /><circle cx="24" cy="26" r="2.4" fill={C.hub} />
              <circle cx="76" cy="26" r="6" fill={C.tyre} /><circle cx="76" cy="26" r="2.4" fill={C.hub} />
            </g>
          </g>
        ),
      )}
    </g>
  )}

  {variant === 'circulation' && (
    <g>
      <rect x="0" y="182" width="320" height="18" fill={C.ground} />
      <line x1="0" x2="320" y1="182" y2="182" stroke={C.groundLine} stroke-width="1.5" />
      <rect x="104" y="6" width="112" height="176" fill="#121a15" stroke={C.steelEdge} stroke-width="2" />
      <rect x="122" y="18" width="76" height="160" rx="34" fill="none" stroke={C.pallet} stroke-width="2" stroke-dasharray="6 5" />
      <path d="M118 104l4-8 4 8M194 96l4 8 4-8" fill="none" stroke={C.pallet} stroke-width="2" />
      {rotarySlots.map((p, i) => (
        <g>
          <rect x={p.x} y={p.y} width="44" height="3" fill={C.pallet} />
          <g transform={car({ x: p.x + 1, y: p.y, s: p.s }).transform}>
            <path d={CAR_BODY} fill={i === 7 ? C.carAccent : C.car} />
            <circle cx="24" cy="26" r="6" fill={C.tyre} />
            <circle cx="76" cy="26" r="6" fill={C.tyre} />
          </g>
        </g>
      ))}
      <g stroke={C.label}>
        <line x1="236" x2="236" y1="6" y2="182" />
        <line x1="232" x2="240" y1="6" y2="6" />
        <line x1="232" x2="240" y1="182" y2="182" />
      </g>
      <text x="244" y="98" fill={C.label} font-family="ui-monospace, monospace" font-size="9">20+ LVL</text>
      <text x="24" y="176" fill={C.label} font-family="ui-monospace, monospace" font-size="9">ENTRY →</text>
    </g>
  )}

  {variant === 'two-wheeler' && (
    <g>
      <rect x="0" y="176" width="320" height="24" fill={C.ground} />
      <line x1="0" x2="320" y1="176" y2="176" stroke={C.groundLine} stroke-width="1.5" />
      {[24, 286].map((px) => (
        <rect x={px} y="40" width="10" height="136" fill={C.steel} stroke={C.steelEdge} />
      ))}
      <rect x="30" y="100" width="260" height="6" fill={C.pallet} />
      {[100, 176].flatMap((deck, row) =>
        [48, 128, 208].map((bx, i) => (
          <g transform={`translate(${bx} ${deck - 38}) scale(1.05)`} fill="none" stroke={row === 0 && i === 1 ? C.carAccent : C.car} stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="10" cy="26" r="9" />
            <circle cx="56" cy="26" r="9" />
            <path d="M10 26 24 12h16l16 14M24 12l6 14h10M40 12l4-8h8M18 9h12" />
          </g>
        )),
      )}
    </g>
  )}

  {variant === 'custom' && (
    <g>
      <rect x="0" y="160" width="320" height="40" fill={C.ground} />
      <line x1="0" x2="320" y1="160" y2="160" stroke={C.groundLine} stroke-width="1.5" />
      <g transform={car({ x: 50, y: 160, s: 2.2 }).transform} fill="none" stroke={C.car} stroke-width="0.7" stroke-dasharray="3 2">
        <path d={CAR_BODY} />
        <path d={CAR_GLASS} />
        <circle cx="24" cy="26" r="6" />
        <circle cx="76" cy="26" r="6" />
      </g>
      <g stroke={C.pallet} stroke-width="1.2" fill="none">
        <path d="M58 178h204M58 174v8M262 174v8M64 176l-6 2 6 2M256 176l6 2-6 2" />
        <path d="M284 90v70M280 90h8M280 160h8" />
      </g>
      <text x="160" y="194" fill={C.pallet} font-family="ui-monospace, monospace" font-size="9" text-anchor="middle">5200 mm</text>
      <text x="292" y="128" fill={C.pallet} font-family="ui-monospace, monospace" font-size="9">2100</text>
      <g transform="translate(240 22)" fill="none" stroke={C.pallet} stroke-width="2">
        <circle cx="24" cy="24" r="10" />
        <path d="M24 4v8M24 36v8M4 24h8M36 24h8M10 10l6 6M32 32l6 6M10 38l6-6M32 16l6-6" stroke-linecap="round" />
      </g>
      <text x="16" y="30" fill={C.label} font-family="ui-monospace, monospace" font-size="9">ENGINEERED TO SITE</text>
    </g>
  )}
</svg>
