---
import Icon from './Icon.astro';
import { Hotel, ShoppingBag, Building2, Building, Cpu } from 'lucide-static';
import { SECTORS } from '../lib/site';

const icons: Record<string, string> = {
  Hotels: Hotel,
  'Malls & Retail': ShoppingBag,
  'Residential Apartments': Building2,
  'Commercial Towers': Building,
  'Smart Buildings': Cpu,
};
---

<section class="asphalt section-py text-white">
  <div class="container-px mx-auto max-w-7xl">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-2xl">
        <span class="eyebrow eyebrow-dark">Sectors Served</span>
        <h2 class="mt-4 text-balance font-display text-3xl font-bold sm:text-4xl">
          Trusted across every property type
        </h2>
      </div>
      <p class="max-w-md text-sm leading-relaxed text-slate-400">
        Wherever land is expensive and parking demand is high, a SmartPARX system turns one bay into two, three, or more.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-px overflow-hidden rounded-lg border border-white/10 bg-white/10 sm:grid-cols-2 lg:grid-cols-5">
      {SECTORS.map((sector, i) => (
        <div class="group bg-navy-950 p-7 transition-colors hover:bg-navy-900">
          <div class="flex items-center justify-between">
            <span class="flex h-12 w-12 items-center justify-center rounded-md border border-signal-500/40 bg-signal-500/10 text-signal-400 transition-colors group-hover:bg-signal-500 group-hover:text-navy-950">
              <Icon svg={icons[sector.title] ?? Building} class="h-6 w-6" />
            </span>
            <span class="font-mono text-[11px] text-slate-500">0{i + 1}</span>
          </div>
          <h3 class="mt-6 font-display text-lg font-semibold">{sector.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-400">{sector.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
