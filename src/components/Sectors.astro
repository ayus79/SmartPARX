---
import { SECTORS } from '../lib/site';
---

<section class="section-py bg-navy-950 text-white">
  <div class="container-px mx-auto max-w-7xl">
    <div class="max-w-2xl">
      <span class="text-sm font-semibold uppercase tracking-wide text-signal-400">Sectors Served</span>
      <h2 class="mt-3 text-balance font-display text-3xl font-bold sm:text-4xl">
        Trusted across every property type
      </h2>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-5">
      {SECTORS.map((sector) => (
        <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
          <h3 class="font-display text-base font-semibold text-signal-400">{sector.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-300">{sector.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
