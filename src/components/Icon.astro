---
/** Renders a lucide-static SVG string with our own sizing classes. */
interface Props {
  svg: string;
  class?: string;
}

const { svg, class: className = 'h-5 w-5' } = Astro.props;
const html = svg
  .replace(/\s(width|height)="24"/g, '')
  .replace('class="lucide', `aria-hidden="true" class="${className} lucide`);
---

<Fragment set:html={html} />
