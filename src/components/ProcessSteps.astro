---
import { PROCESS_STEPS } from '../lib/site';

interface Props {
  title?: string;
  eyebrow?: string;
}

const { title = 'How We Deliver Every Project', eyebrow = 'Our Process' } = Astro.props;
---

<section class="section-py bg-white">
  <div class="container-px mx-auto max-w-7xl">
    <div class="max-w-2xl">
      <span class="text-sm font-semibold uppercase tracking-wide text-signal-600">{eyebrow}</span>
      <h2 class="mt-3 text-balance font-display text-3xl font-bold text-navy-900 sm:text-4xl">{title}</h2>
    </div>

    <ol class="mt-14 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {PROCESS_STEPS.map((item) => (
        <li class="relative rounded-2xl border border-slate-100 bg-slate-50 p-7">
          <span class="font-display text-4xl font-bold text-slate-200">{item.step}</span>
          <h3 class="mt-3 font-display text-lg font-semibold text-navy-900">{item.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-navy-600">{item.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
