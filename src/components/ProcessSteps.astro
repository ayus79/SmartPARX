---
import { PROCESS_STEPS } from '../lib/site';

interface Props {
  title?: string;
  eyebrow?: string;
}

const { title = 'How We Deliver Every Project', eyebrow = 'Our Process' } = Astro.props;
---

<section class="section-py bg-white">
  <div class="container-px mx-auto max-w-7xl">
    <div class="max-w-2xl">
      <span class="eyebrow">{eyebrow}</span>
      <h2 class="mt-4 text-balance font-display text-3xl font-bold text-navy-900 sm:text-4xl">{title}</h2>
    </div>

    <!-- Each step is drawn as a painted parking bay: side lines, bay number on the ground. -->
    <ol class="mt-14 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
      {PROCESS_STEPS.map((item) => (
        <li class="group relative border-x-2 border-dashed border-slate-200 px-7 pt-8 pb-10 -ml-[2px] transition-colors hover:bg-slate-50">
          <div class="flex items-center justify-between">
            <span class="font-mono text-[11px] font-semibold uppercase tracking-widest text-navy-600">Bay {item.step}</span>
            <span class="h-2.5 w-2.5 rounded-full bg-slate-200 transition-colors group-hover:bg-signal-500"></span>
          </div>
          <h3 class="mt-5 font-display text-xl font-semibold text-navy-900">{item.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-navy-600">{item.description}</p>
          <span class="pointer-events-none absolute right-5 bottom-2 select-none font-display text-6xl font-extrabold leading-none text-slate-100 transition-colors group-hover:text-signal-500/15" aria-hidden="true">
            {item.step}
          </span>
          <span class="absolute inset-x-6 bottom-0 h-1 bg-slate-200 transition-colors group-hover:bg-signal-500"></span>
        </li>
      ))}
    </ol>
  </div>
</section>
