---
import { withBase } from '../lib/url';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import ParkingVisual from './ParkingVisual.astro';

interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const { id, data } = product;
const cover = data.imageFit === 'cover';
---

<a href={withBase(`/products/${id}`)} class="group flex h-full flex-col overflow-hidden rounded-[1.5rem] border border-paper-300 bg-white transition-colors hover:border-ink-900">
  <div class:list={['relative aspect-[4/3] overflow-hidden', data.image ? (cover ? 'bg-ink-900' : 'bg-[#e9e9e7]') : 'bg-ink-950']}>
    {data.image ? (
      <Image
        src={data.image}
        alt={data.title}
        widths={[400, 640, 900]}
        sizes="(min-width: 1024px) 30vw, (min-width: 640px) 50vw, 100vw"
        class:list={['h-full w-full transition-transform duration-[1.2s] ease-out-expo group-hover:scale-105', cover ? 'object-cover' : 'object-cover object-center']}
        loading="lazy"
      />
    ) : (
      <ParkingVisual variant={data.illustration ?? 'custom'} class="h-full w-full p-8" />
    )}
    {data.model && (
      <span class="absolute top-4 left-4 rounded-full bg-white/90 px-2.5 py-1 font-mono text-[10px] font-semibold uppercase tracking-wider text-ink-900 backdrop-blur">
        {data.model}
      </span>
    )}
  </div>
  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-start justify-between gap-4">
      <h3 class="font-display text-xl font-semibold tracking-tight text-ink-900">{data.shortName}</h3>
      <span class="shrink-0 rounded-full bg-paper px-2.5 py-1 text-xs font-semibold tabular-nums text-ink-700">{data.capacity}</span>
    </div>
    <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-ink-500">{data.summary}</p>
    <span class="link-arrow mt-auto pt-6 text-ink-900 group-hover:text-signal-600">
      View specifications
      <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </span>
  </div>
</a>
