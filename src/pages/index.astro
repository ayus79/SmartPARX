---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero.astro';
import ClientMarquee from '../components/home/ClientMarquee.astro';
import ModelSelector from '../components/home/ModelSelector.astro';
import RangeBento from '../components/home/RangeBento.astro';
import FitPlanner from '../components/FitPlanner.astro';
import MadeHere from '../components/home/MadeHere.astro';
import Assurance from '../components/home/Assurance.astro';
import Testimonials from '../components/home/Testimonials.astro';
import Faq from '../components/home/Faq.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { SITE } from '../lib/site';
---

<Layout title={SITE.name} description={SITE.description}>
  <Hero />
  <ClientMarquee />
  <ModelSelector />
  <RangeBento />
  <FitPlanner />
  <MadeHere />
  <Assurance />
  <Testimonials />
  <Faq />
  <CtaBanner />
</Layout>
