---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBanner from '../components/CtaBanner.astro';

const categories = ['All', 'Residential', 'Commercial', 'Industrial', 'Pit Systems', 'Puzzle Systems'] as const;

const items = Array.from({ length: 12 }, (_, i) => {
  const category = categories[(i % (categories.length - 1)) + 1];
  return {
    id: i + 1,
    category,
    title: `${category} Installation ${Math.ceil((i + 1) / (categories.length - 1))}`,
  };
});
---

<Layout
  title="Gallery"
  description="Browse SmartPARX's installed parking systems across residential, commercial, industrial, pit, and puzzle parking projects."
>
  <Breadcrumbs items={[{ label: 'Gallery', href: '/gallery' }]} />
  <section class="bg-navy-950 text-white section-py">
    <div class="container-px mx-auto max-w-7xl">
      <span class="text-sm font-semibold uppercase tracking-wide text-signal-400">Gallery</span>
      <h1 class="mt-3 max-w-3xl text-balance font-display text-4xl font-bold sm:text-5xl">Our Work</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-300">
        A look at completed installations across residential, commercial, and industrial sites.
      </p>
    </div>
  </section>

  <section class="section-py bg-white">
    <div class="container-px mx-auto max-w-7xl">
      <div class="flex flex-wrap gap-2" id="gallery-filters">
        {categories.map((category, index) => (
          <button
            type="button"
            data-filter={category}
            class:list={[
              'gallery-filter-btn rounded-full border px-4 py-2 text-sm font-semibold transition-colors',
              index === 0
                ? 'border-navy-900 bg-navy-900 text-white'
                : 'border-slate-200 text-navy-700 hover:border-navy-900',
            ]}
          >
            {category}
          </button>
        ))}
      </div>

      <div id="gallery-grid" class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {items.map((item) => (
          <figure
            class="gallery-item group overflow-hidden rounded-2xl border border-slate-100 bg-slate-50 shadow-card"
            data-category={item.category}
          >
            <div class="flex h-56 items-center justify-center bg-navy-950">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-14 w-14 text-signal-500/80" aria-hidden="true">
                <path d="M4 20V6a2 2 0 0 1 2-2h6l8 8v8a0 0 0 0 1 0 0H6a2 2 0 0 1-2-2Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
                <path d="M9 20v-5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v5" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
              </svg>
            </div>
            <figcaption class="p-4">
              <span class="text-xs font-semibold uppercase tracking-wide text-signal-600">{item.category}</span>
              <p class="mt-1 text-sm font-semibold text-navy-900">{item.title}</p>
            </figcaption>
          </figure>
        ))}
      </div>

      <p class="mt-6 text-sm text-navy-400">
        Project photography coming soon - contact us for a full portfolio.
      </p>
    </div>
  </section>

  <CtaBanner />
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.gallery-filter-btn');
  const items = document.querySelectorAll<HTMLElement>('.gallery-item');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter;

      buttons.forEach((b) => {
        b.classList.remove('bg-navy-900', 'text-white', 'border-navy-900');
        b.classList.add('border-slate-200', 'text-navy-700');
      });
      button.classList.add('bg-navy-900', 'text-white', 'border-navy-900');
      button.classList.remove('border-slate-200', 'text-navy-700');

      items.forEach((item) => {
        const matches = filter === 'All' || item.dataset.category === filter;
        item.classList.toggle('hidden', !matches);
      });
    });
  });
</script>
