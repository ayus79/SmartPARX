---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE } from '../lib/site';
---

<Layout
  title="Contact Us - Free Parking Site Survey"
  description="Call +91 99250 36201 or WhatsApp for a free site survey and quote on car parking systems. Office at Atlantis One, Ahmedabad; factory at Vatva GIDC."
>
  <PageHeader
    kicker="Contact"
    title="Let’s plan your <span class='text-ink-400'>parking.</span>"
    intro="Tell us about the site. Our engineers will come back with a feasibility check and quotation."
    crumbs={[{ label: 'Contact', href: '/contact' }]}
  />

  <section class="container-px mx-auto max-w-[90rem] pb-24">
    <div class="grid gap-4 lg:grid-cols-12">
      <div class="rounded-[1.75rem] border border-paper-300 bg-white p-6 sm:p-10 lg:col-span-7">
        <h2 class="font-display text-2xl font-semibold tracking-tight text-ink-900">Send an enquiry</h2>
        <div class="mt-8"><ContactForm /></div>
      </div>

      <aside class="flex flex-col gap-4 lg:col-span-5">
        <div class="rounded-[1.75rem] bg-ink-950 p-6 text-white sm:p-10">
          <p class="font-mono text-[11px] uppercase tracking-wider text-ink-400">Talk to us</p>
          <ul class="mt-6 space-y-2">
            {SITE.phone.map((p, i) => (
              <li><a href={`tel:${SITE.phoneLinks[i]}`} class="display text-3xl tabular-nums hover:text-signal-400 sm:text-4xl">{p}</a></li>
            ))}
          </ul>
          <a href={`mailto:${SITE.email}`} class="mt-5 inline-block text-lg text-ink-300 underline decoration-signal-500 underline-offset-4 hover:text-white">{SITE.email}</a>
          <a href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener noreferrer" class="mt-8 flex items-center justify-center gap-2 rounded-full bg-[#25d366] px-6 py-3.5 font-semibold text-ink-950 transition-opacity hover:opacity-90">
            Chat on WhatsApp
          </a>
          <p class="mt-6 text-sm text-ink-400">{SITE.hours}</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {[SITE.office, SITE.factory].map((a) => (
            <address class="rounded-[1.5rem] border border-paper-300 bg-white p-6 not-italic">
              <span class="font-mono text-[11px] uppercase tracking-wider text-ink-500">{a.label}</span>
              <span class="mt-3 block leading-relaxed text-ink-800">{a.line1}<br />{a.line2}<br />{a.city}</span>
              <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${a.line1}, ${a.line2}, ${a.city}`)}`} target="_blank" rel="noopener noreferrer" class="link-arrow mt-4 text-signal-600">
                Directions
                <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </a>
            </address>
          ))}
        </div>
      </aside>
    </div>

    <div class="mt-4 overflow-hidden rounded-[1.75rem] border border-paper-300">
      <iframe src={SITE.mapEmbedUrl} title="Map showing the SmartPARX head office in Ahmedabad" class="h-[24rem] w-full grayscale-[0.4]" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </section>
</Layout>
