---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE } from '../lib/site';
---

<Layout
  title="Contact Us"
  description="Get in touch with SmartPARX for a free site assessment and quotation on automated parking systems. Call, WhatsApp, or send an inquiry."
>
  <Breadcrumbs items={[{ label: 'Contact', href: '/contact' }]} />
  <section class="bg-navy-950 text-white section-py">
    <div class="container-px mx-auto max-w-7xl">
      <span class="text-sm font-semibold uppercase tracking-wide text-signal-400">Contact</span>
      <h1 class="mt-3 max-w-3xl text-balance font-display text-4xl font-bold sm:text-5xl">
        Let's talk about your parking requirement
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-300">
        Call us, message us on WhatsApp, or send an inquiry below - our team typically responds within one business day.
      </p>
    </div>
  </section>

  <section class="section-py bg-white">
    <div class="container-px mx-auto grid max-w-7xl gap-12 lg:grid-cols-5">
      <div class="lg:col-span-3">
        <h2 class="font-display text-2xl font-bold text-navy-900">Send an Inquiry</h2>
        <div class="mt-6">
          <ContactForm />
        </div>
      </div>

      <div class="lg:col-span-2">
        <div class="rounded-2xl border border-slate-100 bg-slate-50 p-7 shadow-card">
          <h2 class="font-display text-lg font-semibold text-navy-900">Reach Us Directly</h2>

          <div class="mt-5 flex flex-col gap-3">
            <a
              href={`tel:${SITE.phoneLinks[0]}`}
              class="inline-flex items-center justify-center gap-2 rounded-full bg-navy-900 px-5 py-3 text-sm font-semibold text-white hover:bg-navy-800"
            >
              Call {SITE.phone[0]}
            </a>
            <a
              href={`https://wa.me/${SITE.whatsapp}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-full border border-navy-900 px-5 py-3 text-sm font-semibold text-navy-900 hover:bg-navy-900 hover:text-white"
            >
              Chat on WhatsApp
            </a>
          </div>

          <dl class="mt-8 space-y-5 text-sm">
            <div>
              <dt class="font-semibold text-navy-900">Address</dt>
              <dd class="mt-1 text-navy-600">
                {SITE.address.line1}<br />
                {SITE.address.line2}<br />
                {SITE.address.city}
              </dd>
            </div>
            <div>
              <dt class="font-semibold text-navy-900">Phone</dt>
              <dd class="mt-1 text-navy-600">{SITE.phone[0]}<br />{SITE.phone[1]}</dd>
            </div>
            <div>
              <dt class="font-semibold text-navy-900">Email</dt>
              <dd class="mt-1"><a href={`mailto:${SITE.email}`} class="text-navy-600 hover:text-signal-600">{SITE.email}</a></dd>
            </div>
            <div>
              <dt class="font-semibold text-navy-900">Working Hours</dt>
              <dd class="mt-1 text-navy-600">{SITE.hours}</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-slate-50 pb-16 sm:pb-20 lg:pb-28">
    <div class="container-px mx-auto max-w-7xl">
      <div class="overflow-hidden rounded-2xl border border-slate-200 shadow-card">
        <iframe
          src={SITE.mapEmbedUrl}
          width="100%"
          height="420"
          style="border:0;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="SmartPARX facility location map"
        ></iframe>
      </div>
    </div>
  </section>
</Layout>
