---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import ClientMarquee from '../components/home/ClientMarquee.astro';
import Testimonials from '../components/home/Testimonials.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { MANUFACTURING_STEPS, SITE, STATS } from '../lib/site';
import unit1 from '../assets/images/factory/unit-1.jpg';
import unit2 from '../assets/images/factory/unit-2.jpg';
import stackerRow from '../assets/images/projects/two-level-5.jpg';

const principles = [
  { title: 'Dynamic, robust design', detail: 'Our in-house R&D team works to state-of-the-art manufacturing and engineering practice. We have zero tolerance when it comes to quality.' },
  { title: 'Quick, accurate installation', detail: 'Installed right the first time, so customers rarely need to call our service team.' },
  { title: 'The widest range', detail: 'More than 10 stacker models, plus heavy-duty, puzzle, pit and custom systems - chosen to fit the car and the site.' },
  { title: 'Customisation', detail: 'Parking lifts from 1.8 m to 10 m, and industry tie-ups that let us build to any client requirement.' },
];
---

<Layout
  title="About Us - Car Parking Manufacturer Since 2017"
  description="Founded in 2017 by Aakash Contractor, SmartPARX has installed 2500+ car parking systems from two Ahmedabad units, with in-house hydraulics and ISO 9001:2015."
>
  <PageHeader
    kicker="About"
    title="Specialists in one thing: <span class='text-ink-400'>fitting more cars.</span>"
    intro={`SmartPARX Parking Solutions LLP was founded in ${SITE.founded} by ${SITE.founder} in Ahmedabad.`}
    crumbs={[{ label: 'About', href: '/about' }]}
  />

  <!-- Wide photo with the key numbers docked over its bottom edge. -->
  <section class="container-px mx-auto max-w-[90rem]">
    <div class="relative">
      <Image src={stackerRow} alt="A long row of SmartPARX two-post parking stackers with yellow columns" widths={[640, 1000, 1400, 1800]} sizes="(min-width: 1440px) 1344px, 100vw" class="aspect-[4/3] w-full rounded-[1.75rem] object-cover object-[50%_55%] sm:aspect-[16/9] lg:aspect-[16/7] lg:rounded-[2.25rem]" loading="eager" />
      <span class="absolute top-4 left-4 flex items-center gap-2 rounded-full bg-white/90 py-1.5 pr-4 pl-1.5 text-xs font-medium text-ink-900 backdrop-blur sm:top-6 sm:left-6">
        <span class="rounded-full bg-signal-500 px-2.5 py-1 font-mono text-[10px] font-semibold uppercase tracking-wider text-ink-950">Installed</span>
        Two-post stacker run
      </span>
      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 rounded-b-[1.75rem] bg-gradient-to-t from-ink-950/50 to-transparent lg:rounded-b-[2.25rem]"></div>
    </div>
    <dl class="relative z-10 -mt-12 grid grid-cols-2 gap-3 px-3 sm:-mt-16 sm:gap-4 sm:px-6 lg:-mt-20 lg:grid-cols-4 lg:px-10">
      {STATS.map((s, i) => (
        <div class:list={['reveal flex flex-col-reverse rounded-[1.25rem] p-5 shadow-[0_18px_40px_-20px_rgb(11_17_13/0.45)] sm:rounded-[1.5rem] sm:p-7', i === 0 ? 'bg-signal-500 text-ink-950' : i === 3 ? 'bg-ink-950 text-white' : 'bg-white text-ink-900']}>
          <dt class:list={['mt-2 text-sm leading-snug', i === 0 ? 'text-ink-950/75' : i === 3 ? 'text-ink-300' : 'text-ink-500']}>{s.label}</dt>
          <dd class="display text-4xl tabular-nums sm:text-5xl lg:text-6xl">{s.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="container-px mx-auto max-w-[90rem] section-py">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="kicker">Our story</p>
      </div>
      <div class="space-y-6 text-xl leading-relaxed text-pretty text-ink-700 lg:col-span-8 lg:text-2xl lg:leading-[1.5]">
        <p>
          <strong class="font-semibold text-ink-900">SmartPARX</strong> is a specialty car parking manufacturing brand, expert in the customized design, manufacturing and execution of parking equipment - with the capacity to deliver parking solutions anywhere.
        </p>
        <p>
          Since {SITE.founded} we’ve installed <strong class="font-semibold text-ink-900">2500+ parking systems</strong>, and we keep expanding our manufacturing to meet India’s demand for car parking.
        </p>
        <p>
          Our partnership with <strong class="font-semibold text-ink-900">Shalin Hydraulics</strong> makes us the only brand in the market with indigenous hydraulic solutions and an in-house manufacturing plant. Our engineers and technicians work to <strong class="font-semibold text-ink-900">ISO 9001:2015</strong>, with technical training and quality control at the centre of everything we ship.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-white section-py">
    <div class="container-px mx-auto max-w-[90rem]">
      <div class="grid gap-14 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="kicker">Production</p>
          <h2 class="display mt-6 text-display-2 text-ink-900">Two units. One roof for every part.</h2>
          <p class="mt-5 leading-relaxed text-ink-600">A fleet of Indian, American, Chinese, Swiss and German machinery and tools - from laser cutting to honing.</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 lg:col-span-8">
          {[
            { src: unit1, alt: 'SmartPARX manufacturing Unit 1 at Vatva GIDC, Ahmedabad', label: 'Unit 1 · Vatva GIDC, Phase-IV' },
            { src: unit2, alt: 'SmartPARX manufacturing Unit 2, with Shalin Hydraulics signage at the gate', label: 'Unit 2 · Shalin Hydraulics partnership' },
          ].map((u) => (
            <figure class="reveal">
              <Image src={u.src} alt={u.alt} widths={[480, 800, 1100]} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 50vw, 100vw" class="aspect-[4/3] w-full rounded-[1.5rem] object-cover" loading="lazy" />
              <figcaption class="mt-3 font-mono text-[11px] uppercase tracking-wider text-ink-500">{u.label}</figcaption>
            </figure>
          ))}
        </div>
      </div>
      <ol class="mt-16 grid gap-px overflow-hidden rounded-[1.5rem] border border-paper-300 bg-paper-300 sm:grid-cols-2 lg:grid-cols-6">
        {MANUFACTURING_STEPS.map((step, i) => (
          <li class="bg-paper p-6">
            <span class="font-mono text-xs text-signal-600">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 font-display text-base font-semibold tracking-tight text-ink-900">{step.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-ink-500">{step.detail}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="container-px mx-auto max-w-[90rem] section-py">
    <p class="kicker">What we stand for</p>
    <ul class="mt-10 grid gap-px overflow-hidden rounded-[1.75rem] border border-paper-300 bg-paper-300 sm:grid-cols-2 lg:grid-cols-4">
      {principles.map((p) => (
        <li class="bg-white p-7">
          <h3 class="font-display text-xl font-semibold tracking-tight text-ink-900">{p.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink-600">{p.detail}</p>
        </li>
      ))}
    </ul>
    <ul class="mt-6 flex flex-wrap gap-2">
      {SITE.certifications.map((c) => <li class="rounded-full bg-ink-900 px-3.5 py-1.5 font-mono text-[11px] uppercase tracking-wider text-white">{c}</li>)}
    </ul>
  </section>

  <ClientMarquee />
  <Testimonials />
  <CtaBanner />
</Layout>
