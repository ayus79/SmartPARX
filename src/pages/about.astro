---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { STATS } from '../lib/site';

const philosophy = [
  {
    title: 'Vision',
    description:
      'To be India’s most trusted name in automated parking engineering, building long-term relationships through reliability and after-sales support.',
  },
  {
    title: 'Mission',
    description:
      'To meet the country’s growing urban parking demand with space-efficient, safe, and innovative mechanical parking systems.',
  },
  {
    title: 'Facility',
    description:
      'A 10,000+ sq. ft. state-of-the-art manufacturing facility in Vatva, Ahmedabad, covering fabrication, coating, and quality testing under one roof.',
  },
  {
    title: 'Quality Standard',
    description:
      'Every system undergoes structural load testing and safety verification before commissioning, following our in-house quality protocol.',
  },
];
---

<Layout
  title="About Us"
  description="35+ years of engineering experience. Learn about SmartPARX's manufacturing facility, mission, and quality standards in automated parking systems."
>
  <Breadcrumbs items={[{ label: 'About Us', href: '/about' }]} />
  <section class="bg-navy-950 text-white section-py">
    <div class="container-px mx-auto max-w-7xl">
      <span class="text-sm font-semibold uppercase tracking-wide text-signal-400">About Us</span>
      <h1 class="mt-3 max-w-3xl text-balance font-display text-4xl font-bold sm:text-5xl">
        Engineering parking solutions since day one
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-300">
        SmartPARX specializes in the research, development, design, manufacturing, marketing, installation, and commissioning of automated parking equipment - serving clients across India and beyond.
      </p>

      <dl class="mt-16 grid grid-cols-2 gap-6 border-t border-white/10 pt-10 sm:grid-cols-4">
        {STATS.map((stat) => (
          <div>
            <dt class="sr-only">{stat.label}</dt>
            <dd class="font-display text-3xl font-bold text-signal-500 sm:text-4xl">{stat.value}</dd>
            <p class="mt-1 text-sm text-slate-400">{stat.label}</p>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section-py bg-white">
    <div class="container-px mx-auto max-w-7xl">
      <div class="max-w-2xl">
        <span class="text-sm font-semibold uppercase tracking-wide text-signal-600">Our Philosophy</span>
        <h2 class="mt-3 text-balance font-display text-3xl font-bold text-navy-900 sm:text-4xl">
          Vision, mission, and the standards behind it
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2">
        {philosophy.map((item) => (
          <div class="rounded-2xl border border-slate-100 bg-slate-50 p-7 shadow-card">
            <h3 class="font-display text-lg font-semibold text-navy-900">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-navy-600">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ProcessSteps title="Our Manufacturing & Quality Process" eyebrow="How We Work" />
  <CtaBanner />
</Layout>
