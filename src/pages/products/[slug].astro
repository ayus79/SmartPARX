---
import { withBase } from '../../lib/url';
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Button from '../../components/Button.astro';
import ProductCard from '../../components/ProductCard.astro';
import ParkingVisual from '../../components/ParkingVisual.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { SITE } from '../../lib/site';
import { FAMILIES } from '../../lib/visuals';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({ params: { slug: product.id }, props: { product, all: products } }));
}

const { product, all } = Astro.props;
const { data } = product;
const { Content } = await render(product);

const images = [data.image, ...data.gallery].filter((img): img is NonNullable<typeof img> => Boolean(img));
const ogImage = images[0] ? (await getImage({ src: images[0], width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src : undefined;

const specs = [
  ['Lifting capacity', data.capacity],
  ['Platform sizes', data.platformSizes],
  ['Structure', data.structure],
  ['Lift mechanism', data.mechanism],
  ['System weight', data.weight],
  ['Reverse parking', data.reverseParking],
  ['Base length', data.baseLength],
  ['Finish', data.paint],
  ['Colours', data.colours],
].filter((row): row is [string, string] => Boolean(row[1]));

const keyFigures = [
  { label: 'Capacity', value: data.capacity },
  data.reverseParking && { label: 'Reverse', value: data.reverseParking.replace(/ advisable/i, '').replace('Up to ', '≤ ') },
  data.platformSizes && { label: 'Platform', value: data.platformSizes.replace(', ', ' / ').replace(/, /g, ' / ') },
].filter(Boolean) as { label: string; value: string }[];

const related = all
  .filter((p) => p.id !== product.id && p.data.family === data.family)
  .concat(all.filter((p) => p.id !== product.id && p.data.family !== data.family))
  .slice(0, 3);

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: data.title,
  description: data.summary,
  ...(data.model && { model: data.model }),
  ...(ogImage && { image: new URL(ogImage, Astro.site).toString() }),
  brand: { '@type': 'Brand', name: SITE.name },
  manufacturer: { '@id': new URL(withBase('/#organization'), Astro.site).toString() },
  category: 'Car parking system',
  additionalProperty: specs.map(([name, value]) => ({ '@type': 'PropertyValue', name, value })),
};
---

<Layout title={data.title} description={data.summary} image={ogImage} type="product">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(productSchema)} />

  <section class="container-px mx-auto max-w-[90rem] pt-8 sm:pt-12">
    <Breadcrumbs items={[{ label: 'Products', href: '/products' }, { label: data.shortName, href: `/products/${product.id}` }]} />

    <div class="mt-10 grid gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-7" data-gallery>
        <div class:list={['relative overflow-hidden rounded-[1.75rem]', images.length ? (data.imageFit === 'cover' ? 'bg-ink-900' : 'bg-[#e9e9e7]') : 'bg-ink-950']}>
          {images.length > 0 ? (
            images.map((img, i) => (
              <Image
                src={img}
                alt={`${data.title}${i ? ` - view ${i + 1}` : ''}`}
                widths={[640, 960, 1400]}
                sizes="(min-width: 1024px) 60vw, 100vw"
                class:list={['aspect-[4/3] w-full', data.imageFit === 'cover' || i > 0 ? 'object-cover' : 'object-cover', i > 0 && 'hidden']}
                data-slide={i}
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : undefined}
              />
            ))
          ) : (
            <ParkingVisual variant={data.illustration ?? 'custom'} class="aspect-[4/3] w-full p-10" />
          )}
        </div>
        {images.length > 1 && (
          <div class="mt-3 grid grid-cols-4 gap-3" role="group" aria-label="Product images">
            {images.map((img, i) => (
              <button type="button" data-thumb={i} aria-label={`Show image ${i + 1}`} aria-pressed={i === 0 ? 'true' : 'false'} class="overflow-hidden rounded-xl border-2 border-transparent bg-[#e9e9e7] transition-colors aria-pressed:border-ink-900">
                <Image src={img} alt="" width={240} class="aspect-[4/3] w-full object-cover" loading="lazy" />
              </button>
            ))}
          </div>
        )}
      </div>

      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-28">
          <a href={withBase(`/products#${data.family}`)} class="kicker hover:text-ink-900">{FAMILIES[data.family].label}</a>
          <h1 class="display mt-5 text-display-1 text-ink-900">{data.title.replace('Two Post Parking Stacker - ', '')}</h1>
          {data.family === 'two-post' && <p class="mt-2 font-display text-lg text-ink-500">Two-post parking stacker</p>}
          <p class="mt-6 text-lg leading-relaxed text-pretty text-ink-600">{data.summary}</p>

          <dl class="mt-8 grid grid-cols-3 divide-x divide-paper-300 rounded-2xl border border-paper-300 bg-white">
            {keyFigures.map((f) => (
              <div class="p-4">
                <dt class="font-mono text-[10px] uppercase tracking-wider text-ink-500">{f.label}</dt>
                <dd class="mt-1.5 text-sm font-semibold tabular-nums text-ink-900">{f.value}</dd>
              </div>
            ))}
          </dl>

          {data.variants.length > 0 && (
            <div class="mt-6 flex flex-wrap items-center gap-2">
              <span class="mr-1 text-sm text-ink-500">Variants</span>
              {data.variants.map((v) => <span class="rounded-full bg-ink-900 px-2.5 py-1 font-mono text-[11px] text-white">{v}</span>)}
            </div>
          )}

          <div class="mt-8 flex flex-wrap gap-3">
            <Button href={`/contact?system=${encodeURIComponent(data.shortName)}`} size="lg">Get a quote</Button>
            <Button
              href={`https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(`Hi SmartPARX, I'm interested in the ${data.title}.`)}`}
              variant="outline"
              size="lg"
              arrow={false}
              target="_blank"
              rel="noopener noreferrer"
            >
              WhatsApp us
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="container-px mx-auto max-w-[90rem] section-py">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 class="display text-display-3 text-ink-900">Technical specifications</h2>
        <dl class="mt-6 border-t border-paper-300">
          {specs.map(([label, value]) => (
            <div class="spec-row"><dt>{label}</dt><dd>{value}</dd></div>
          ))}
        </dl>
        {data.addons.length > 0 && (
          <div class="mt-10">
            <h3 class="font-mono text-[11px] uppercase tracking-wider text-ink-500">Optional add-ons</h3>
            <ul class="mt-4 flex flex-wrap gap-2">
              {data.addons.map((a) => <li class="rounded-full border border-paper-300 bg-white px-3.5 py-1.5 text-sm text-ink-700">{a}</li>)}
            </ul>
          </div>
        )}
      </div>

      <div class="lg:col-span-6 lg:col-start-7">
        <div class="text-lg leading-relaxed text-ink-700 [&_p+p]:mt-4">
          <Content />
        </div>
        {data.features.length > 0 && (
          <ol class="mt-10 space-y-px overflow-hidden rounded-2xl border border-paper-300 bg-paper-300">
            {data.features.map((f, i) => (
              <li class="flex gap-5 bg-white p-5">
                <span class="font-mono text-xs text-signal-600">{String(i + 1).padStart(2, '0')}</span>
                <span class="text-ink-800">{f}</span>
              </li>
            ))}
          </ol>
        )}
        {data.family === 'two-post' && (
          <a href={withBase('/planning-guide')} class="group mt-10 flex items-center justify-between gap-6 rounded-2xl bg-ink-950 p-6 text-white">
            <span>
              <span class="block font-display text-lg font-semibold">Check your clear height and bay width</span>
              <span class="mt-1 block text-sm text-ink-300">Sedan + Sedan needs 3400 mm · SUV + SUV needs 4300 mm</span>
            </span>
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-signal-500 text-ink-950 transition-transform duration-500 ease-out-expo group-hover:-rotate-45">
              <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </span>
          </a>
        )}
      </div>
    </div>
  </section>

  <section class="container-px mx-auto max-w-[90rem] border-t border-paper-300 py-16 sm:py-20">
    <h2 class="display text-display-3 text-ink-900">Compare with</h2>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {related.map((p) => <li><ProductCard product={p} /></li>)}
    </ul>
  </section>

  <CtaBanner />
</Layout>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const slides = root.querySelectorAll<HTMLElement>('[data-slide]');
    const thumbs = root.querySelectorAll<HTMLButtonElement>('[data-thumb]');
    thumbs.forEach((thumb) =>
      thumb.addEventListener('click', () => {
        const i = thumb.dataset.thumb;
        slides.forEach((s) => s.classList.toggle('hidden', s.dataset.slide !== i));
        thumbs.forEach((t) => t.setAttribute('aria-pressed', String(t === thumb)));
      }),
    );
  });
</script>
