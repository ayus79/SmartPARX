---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProductCard from '../../components/ProductCard.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { FAMILIES } from '../../lib/visuals';

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const groups = (Object.keys(FAMILIES) as (keyof typeof FAMILIES)[]).map((key) => ({
  key,
  ...FAMILIES[key],
  items: products.filter((p) => p.data.family === key),
}));
---

<Layout
  title="Car Parking Systems - Stackers, Puzzle & Pit"
  description="Compare 12 car parking systems: two-post stackers from 2000 to 2700 kg, heavy-duty, puzzle, pit, three-level and two-wheeler parking. Full specs and quotes."
>
  <PageHeader
    kicker="Products"
    title="Every system we build, <span class='text-ink-400'>with full specs.</span>"
    intro="Twelve systems across four families - all manufactured in our Ahmedabad units and installed by our own crews."
    crumbs={[{ label: 'Products', href: '/products' }]}
  >
    <nav class="mt-12 flex flex-wrap gap-2" aria-label="Product families">
      {groups.map((g) => (
        <a href={`#${g.key}`} class="rounded-full border border-paper-300 bg-white px-4 py-2 text-sm font-medium text-ink-700 transition-colors hover:border-ink-900 hover:text-ink-900">
          {g.label} <span class="ml-1 text-ink-400 tabular-nums">{g.items.length}</span>
        </a>
      ))}
    </nav>
  </PageHeader>

  {groups.map((g, i) => (
    <section id={g.key} class="container-px mx-auto max-w-[90rem] scroll-mt-24 border-t border-paper-300 py-14 sm:py-20">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-3">
          <p class="font-mono text-[11px] text-signal-600">0{i + 1}</p>
          <h2 class="mt-3 display text-display-3 text-ink-900">{g.label}</h2>
          <p class="mt-3 text-sm leading-relaxed text-ink-500">{g.blurb}</p>
        </div>
        <ul class="grid gap-4 sm:grid-cols-2 lg:col-span-9 lg:grid-cols-3">
          {g.items.map((p) => <li class="reveal"><ProductCard product={p} /></li>)}
        </ul>
      </div>
    </section>
  ))}

  <CtaBanner title="Not sure which system fits your site?" description="Send us your floor plan and clear height - we’ll recommend the right system and layout." />
</Layout>
