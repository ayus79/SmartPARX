---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductCard from '../../components/ProductCard.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { getCollection } from 'astro:content';

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="Products"
  description="Explore SmartPARX's full range of automated parking systems: stackers, puzzle systems, pit parking, vertical circulation, two-wheeler, and custom solutions."
>
  <Breadcrumbs items={[{ label: 'Products', href: '/products' }]} />
  <section class="bg-navy-950 text-white section-py">
    <div class="container-px mx-auto max-w-7xl">
      <span class="text-sm font-semibold uppercase tracking-wide text-signal-400">Products</span>
      <h1 class="mt-3 max-w-3xl text-balance font-display text-4xl font-bold sm:text-5xl">
        55+ variants across 7 system families
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-300">
        From a simple two-level stacker to a fully custom PLC-controlled puzzle matrix - every system is manufactured in-house and engineered to your site.
      </p>
    </div>
  </section>

  <section class="section-py bg-slate-50">
    <div class="container-px mx-auto max-w-7xl">
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((product) => <ProductCard product={product} />)}
      </div>
    </div>
  </section>

  <CtaBanner />
</Layout>
