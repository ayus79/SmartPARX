---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
---

<Layout title="Page Not Found" description="The page you're looking for doesn't exist." noindex>
  <section class="container-px mx-auto flex min-h-[70vh] max-w-[90rem] flex-col justify-center py-24">
    <p class="kicker">Error 404</p>
    <h1 class="display mt-6 text-[clamp(3rem,10vw,9rem)] text-ink-900">This bay is <span class="text-signal-600">empty.</span></h1>
    <p class="mt-6 max-w-lg text-lg text-ink-600">The page you’re looking for has moved or doesn’t exist.</p>
    <div class="mt-10 flex flex-wrap gap-3">
      <Button href="/" size="lg">Back to home</Button>
      <Button href="/products" variant="outline" size="lg" arrow={false}>Browse products</Button>
    </div>
  </section>
</Layout>
