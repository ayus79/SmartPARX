---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { SERVICES } from '../lib/site';
---

<Layout
  title="Services"
  description="Turnkey parking system services from SmartPARX: layout planning, architectural integration, custom manufacturing, installation, and AMC support."
>
  <Breadcrumbs items={[{ label: 'Services', href: '/services' }]} />
  <section class="bg-navy-950 text-white section-py">
    <div class="container-px mx-auto max-w-7xl">
      <span class="text-sm font-semibold uppercase tracking-wide text-signal-400">Services</span>
      <h1 class="mt-3 max-w-3xl text-balance font-display text-4xl font-bold sm:text-5xl">
        Turnkey delivery, from feasibility to maintenance
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-300">
        We handle every stage of a parking system project so you work with a single accountable partner - not a chain of subcontractors.
      </p>
    </div>
  </section>

  <section class="section-py bg-white">
    <div class="container-px mx-auto max-w-7xl">
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
        {SERVICES.map((service, index) => (
          <div class="flex gap-5 rounded-2xl border border-slate-100 bg-slate-50 p-7 shadow-card">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-navy-900 font-display text-lg font-bold text-signal-500">
              {String(index + 1).padStart(2, '0')}
            </span>
            <div>
              <h2 class="font-display text-lg font-semibold text-navy-900">{service.title}</h2>
              <p class="mt-2 text-sm leading-relaxed text-navy-600">{service.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBanner
    title="Have a project in mind?"
    description="Send us your site details and requirement - we'll respond with a feasibility assessment and quotation."
  />
</Layout>
