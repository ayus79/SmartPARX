---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Assurance from '../components/home/Assurance.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { SERVICES } from '../lib/site';
import row from '../assets/images/projects/two-level-2.jpg';
---

<Layout
  title="Parking System Services - Survey, Design, Installation & AMC"
  description="Turnkey car parking system services from SmartPARX: site survey and feasibility, customized design, in-house manufacturing, installation and commissioning, and a 2 + 5 year warranty with AMC."
>
  <PageHeader
    kicker="Services"
    title="One team, <span class='text-ink-400'>from survey to service.</span>"
    intro="We survey, design, manufacture, install and maintain - so you deal with one accountable partner, not a chain of subcontractors."
    crumbs={[{ label: 'Services', href: '/services' }]}
  />

  <section class="container-px mx-auto max-w-[90rem] pb-20 sm:pb-28">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-28">
          <Image src={row} alt="Row of SmartPARX two-post stackers after installation" widths={[480, 800, 1100]} sizes="(min-width: 1024px) 40vw, 100vw" class="aspect-[4/5] w-full rounded-[1.75rem] object-cover" loading="eager" />
        </div>
      </div>
      <ol class="lg:col-span-7">
        {SERVICES.map((s, i) => (
          <li class="reveal grid grid-cols-[3.5rem_1fr] gap-4 border-t border-paper-300 py-10 first:border-t-0 first:pt-0 sm:grid-cols-[5rem_1fr]">
            <span class="display text-4xl text-signal-600 tabular-nums sm:text-5xl">0{i + 1}</span>
            <div>
              <h2 class="font-display text-2xl font-semibold tracking-tight text-ink-900 sm:text-3xl">{s.title}</h2>
              <p class="mt-3 max-w-xl text-lg leading-relaxed text-ink-600">{s.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Assurance />
  <CtaBanner title="Have a project in mind?" description="Share your drawings and requirement - we’ll come back with a feasibility check and quotation." />
</Layout>
