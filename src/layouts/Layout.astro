---
import { withBase } from '../lib/url';
import '@fontsource-variable/inter';
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  type?: 'website' | 'article' | 'product';
}

const { title, description, image, noindex, type } = Astro.props;
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f4f3ee" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <Seo title={title} description={description} image={image} noindex={noindex} type={type} />
  </head>
  <body class="min-h-screen">
    <a href="#main" class="sr-only z-[100] rounded-full bg-ink-900 px-5 py-3 text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <a
      href={`https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent('Hi SmartPARX, I would like a quote for a parking system.')}`}
      target="_blank"
      rel="noopener noreferrer"
      class="fixed right-4 bottom-4 z-40 flex h-14 w-14 items-center justify-center rounded-full bg-[#25d366] text-white shadow-lg shadow-ink-950/20 transition-transform hover:scale-105 sm:right-6 sm:bottom-6"
      aria-label="Chat with SmartPARX on WhatsApp"
    >
      <svg viewBox="0 0 24 24" class="h-7 w-7" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.48-1.75-1.65-2.05-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.5h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.08 4.49.71.3 1.27.49 1.7.63.72.23 1.37.2 1.88.12.57-.08 1.75-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35M12.05 21.5h-.01a9.4 9.4 0 0 1-4.8-1.31l-.34-.2-3.57.93.95-3.48-.22-.36a9.4 9.4 0 0 1-1.44-5.02c0-5.2 4.24-9.43 9.44-9.43a9.38 9.38 0 0 1 9.43 9.44c0 5.2-4.23 9.43-9.44 9.43m8.03-17.46A11.27 11.27 0 0 0 12.05.72C5.8.72.7 5.8.7 12.06c0 2 .52 3.95 1.52 5.67L.6 23.62l6.03-1.58a11.33 11.33 0 0 0 5.42 1.38h.01c6.25 0 11.34-5.09 11.35-11.35 0-3.03-1.18-5.88-3.33-8.03"/></svg>
    </a>

    <!-- Back to top: sits above the WhatsApp button on the same centre line. -->
    <button
      id="to-top"
      type="button"
      aria-label="Back to top"
      tabindex="-1"
      class="group fixed right-5 bottom-[5.25rem] z-40 flex h-12 w-12 translate-y-3 items-center justify-center rounded-full bg-ink-900 text-white opacity-0 shadow-lg shadow-ink-950/20 transition-[opacity,transform,background-color] duration-300 ease-out-expo pointer-events-none hover:bg-ink-800 data-[shown]:pointer-events-auto data-[shown]:translate-y-0 data-[shown]:opacity-100 sm:right-7 sm:bottom-[6rem]"
    >
      <svg viewBox="0 0 24 24" fill="none" class="relative h-5 w-5 transition-transform duration-300 group-hover:-translate-y-0.5" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>

    <script>
      const toTop = document.getElementById('to-top');
      let ticking = false;

      const update = () => {
        ticking = false;
        const shown = window.scrollY > window.innerHeight * 0.8;
        toTop?.toggleAttribute('data-shown', shown);
        toTop?.setAttribute('tabindex', shown ? '0' : '-1');
      };
      window.addEventListener('scroll', () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      }, { passive: true });
      update();

      toTop?.addEventListener('click', () => {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
        // Return keyboard focus to the start of the page rather than leaving it on a now-hidden button.
        document.querySelector<HTMLElement>('#site-header a')?.focus({ preventScroll: true });
      });
    </script>

    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
